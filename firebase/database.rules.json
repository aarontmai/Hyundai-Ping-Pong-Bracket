{
  "rules": {
    "bracket": {
      ".read": true,
      ".write": true,
      "teams": {
        "$i": {
          ".validate": "$i.matches(/^([0-9]|1[0-5])$/) && newData.isString() && newData.val().length <= 40"
        }
      },
      "w": {
        "$m": {
          ".validate": "$m.matches(/^(a|b|c|d|e|f2|g|h|q1|q2|q3|q4|s1|s2|f)$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 16"
        }
      },
      "$other": { ".validate": false }
    }
  }
}
